# AIAAM Environment Variables
# Copy to .env and fill with real values. Never commit .env to git.

# Anthropic API (LLM Translator)
ANTHROPIC_API_KEY=sk-ant-...

# GitHub API (extracción de READMEs)
GITHUB_TOKEN=ghp_...

# HuggingFace API (extracción de model cards) - opcional
HF_TOKEN=hf_...

# Database
DATABASE_URL=sqlite:///aiaam.db
# Producción PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host:5432/aiaam

# Admin endpoint protection
ADMIN_SECRET=change-this-to-a-long-random-string

# Models
TRANSLATOR_MODEL_PRIMARY=claude-haiku-4-5-20251001
TRANSLATOR_MODEL_REVIEWER=claude-sonnet-4-6
USE_BATCH_API=true

# Server
HOST=0.0.0.0
PORT=8000
